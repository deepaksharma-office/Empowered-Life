      "type": "header",
      "content": "Carousel controls"
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show navigation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "auto_rotate_interval",
      "label": "Auto-rotate interval",
      "min": 3000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
