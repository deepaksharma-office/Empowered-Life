      "id": "accent_color",
      "label": "Accent color",
      "default": "#c9a961"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a2332"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#5a6c7d"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote color",
      "default": "#2d3748"
    },
