<div class="gold-line" aria-hidden="true" style="--story-line-width: {{ block.settings.width }}px; --story-color: {{ block.settings.color }}"></div>
<style>
  .gold-line{
      width: min(100%, var(--story-line-width));
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--story-color), transparent);
  }
</style>
{% schema %}
{
  "name": "Gold Line",
  "settings": [
    {
      "type": "color",
      "id": "color",
      "label": "Line color",
      "default": "#b68a24"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Width",
      "min": 20,
      "max": 200,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Gold Line"
    }
  ]
}
{% endschema %}
