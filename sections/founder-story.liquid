{{ 'founder-story.css' | asset_url | stylesheet_tag }}
<script src="{{ 'founder-story.js' | asset_url }}" type="module"></script>

<founder-story class="founder-story founder-story--{{ section.settings.image_position }}"
  style="--story-background: {{ section.settings.background }}; --story-accent: {{ section.settings.accent }}; --story-radius: {{ section.settings.radius }}px; --story-spacing: {{ section.settings.spacing }}px; --story-width: {{ section.settings.content_width }}px; --story-separator: {{ section.settings.separator }};"
>
  <div class="founder-story__layout">
    <div class="founder-story__portrait" data-story-reveal style="--story-delay: 0ms;">
      {% if section.settings.image != blank %}
        {% liquid
          assign loading = 'lazy'
          if section.index == 1
            assign loading = 'eager'
          endif
        %}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '375, 550, 750, 1100, 1600', sizes: '(min-width: 750px) 45vw, 90vw', loading: loading }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'founder-story__placeholder' }}
      {% endif %}
    </div>
    <div class="founder-story__content">
      {% for block in section.blocks %}
        <div class="founder-story__block founder-story__block--{{ block.type }}" data-story-reveal
          style="--story-delay: {{ forloop.index | at_most: 12 | times: 80 }}ms; --story-color: {{ block.settings.color }}; --story-size: {{ block.settings.size }}px; --story-leading: {{ block.settings.line_height | default: 150 | divided_by: 100.0 }}; --story-align: {{ block.settings.alignment | default: 'left' }}; --story-margin: {{ block.settings.spacing | default: 0 }}px;"
          {{ block.shopify_attributes }}
        >
          {% case block.type %}
            {% when 'eyebrow' %}
              <p class="founder-story__eyebrow" style="--story-tracking: {{ block.settings.tracking | divided_by: 100.0 }}em;">{{ block.settings.text }}</p>
            {% when 'title' %}
              <{{ block.settings.tag }} class="founder-story__title" style="--story-mobile-size: {{ block.settings.mobile_size }}px;">{{ block.settings.text }}</{{ block.settings.tag }}>
            {% when 'role' %}
              <p>{{ block.settings.text }}</p>
            {% when 'body_text' %}
              <div class="rte">{{ block.settings.text }}</div>
            {% when 'gold_line' %}
              <div class="gold-line" aria-hidden="true" style="--story-line-width: {{ block.settings.width }}px;"></div>
            {% when 'highlight_dialogue' %}
              <blockquote class="founder-story__dialogue rte" style="--story-quote-bg: {{ block.settings.background }}; --story-quote-border: {{ block.settings.border_color }}; --story-quote-border-width: {{ block.settings.border_width }}px; --story-quote-padding: {{ block.settings.padding }}px;">{{ block.settings.text }}</blockquote>
            {% when 'information_item' %}
              {% if block.settings.image != blank %}
                <div class="founder-story__icon">{% render 'image', image: block.settings.image, height: 40 %}</div>
              {% endif %}
              <p class="founder-story__stat">{{ block.settings.text }}</p>
              <p class="founder-story__support" style="color: {{ block.settings.support_color }}; font-size: {{ block.settings.support_size }}px;">{{ block.settings.support }}</p>
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
</founder-story>

