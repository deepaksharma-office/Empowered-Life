            "content": "<p>Compassionate support to help you rediscover joy, purpose, and renewed hope.</p>"
          }
        },
        {
          "type": "service",
          "settings": {
            "type": "sun",
            "title": "Life Transitions",
            "content": "<p>Guidance through career changes, relocation, parenthood, and major life shifts.</p>"
          }
        },
        {
