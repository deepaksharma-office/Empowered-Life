    "founder_story_cUABLw": {
      "type": "founder-story",
      "blocks": {
        "eyebrow_w44PRy": {
          "type": "eyebrow",
          "settings": {
            "text": "Founder Story & Professional Background",
            "color": "#b68a24",
            "size": 11,
            "alignment": "left",
            "tracking": 16
          }
        },
        "title_PnNzxm": {
          "type": "title",
          "settings": {
            "text": "Meet Denise Baron",
            "color": "#123c5a",
            "size": 42,
            "line_height": 150,
            "alignment": "left",
            "mobile_size": 32,
            "tag": "h2"
          }
        },
        "role_hbUWTy": {
          "type": "role",
          "settings": {
            "text": "Lead Counselor & Founder",
            "color": "#123c5a",
            "size": 12,
            "spacing": 18
          }
        },
        "gold_line_YNQciH": {
          "type": "gold_line",
          "settings": {
            "color": "#b68a24",
            "width": 64
          }
        },
        "body_text_ykcTnV": {
          "type": "body_text",
          "settings": {
            "text": "<p>Denise Baron is a Licensed Christian Counselor and advocate with over 20 years of experience in domestic violence intervention, crisis support, and trauma-informed care. Her professional work has centered on empowering individuals in crisis to rebuild safety, stability, and self-worth.</p>",
            "color": "#52697a",
            "size": 15,
            "line_height": 150,
            "spacing": 0
          }
        },
        "body_text_h7NCfG": {
          "type": "body_text",
          "settings": {
            "text": "<p>She is a proud graduate of Kingdom Christian University (KCU), a Licensed Christian Counselor and ordained minister.</p>",
            "color": "#52697a",
            "size": 15,
            "line_height": 150,
            "spacing": 0
          }
        },
        "body_text_dNBiiB": {
          "type": "body_text",
          "settings": {
            "text": "<p>Her counseling philosophy is shaped by both professional training and personal life experience. Having walked through her own seasons of pain, transition, and restoration, she brings a deeply empathetic and grounded approach to her work.</p>",
            "color": "#52697a",
            "size": 15,
            "line_height": 150,
            "spacing": 0
          }
        },
        "body_text_X3wbKH": {
          "type": "body_text",
          "settings": {
            "text": "<p>She is also a mother of two adopted sons and resides in Florida, where her environment of peace, warmth, and coastal beauty reflects her commitment to restoration and renewal.</p>",
            "color": "#52697a",
            "size": 15,
            "line_height": 150,
            "spacing": 0
          }
        },
        "highlight_dialogue_NxVUMC": {
          "type": "highlight_dialogue",
          "settings": {
            "text": "<p>\"I believe every person carries a story worth honoring. My approach is rooted in the conviction that healing is possible, hope is available, and no one should have to walk through life?s challenges alone.\"</p>",
            "color": "#123c5a",
            "size": 16,
            "line_height": 150,
            "background": "#f4f0e2",
            "border_color": "#b68a24",
            "border_width": 2,
            "padding": 24
          }
        },
        "information_item_R7Fadt": {
          "type": "information_item",
          "settings": {
            "text": "20+",
            "color": "#b68a24",
            "size": 24,
            "support": "Years of Service",
            "support_color": "#52697a",
            "support_size": 11
          }
